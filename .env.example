# Copy to .env.local for local overrides.
# Business contact details are set directly in src/lib/site-config.ts.

# Public site URL, used for canonical and Open Graph URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Enquiry emails (Resend, https://resend.com). Server-side only: never prefix with NEXT_PUBLIC_.
# The enquiry form reports an error instead of success until all three are set.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Serendib Crown Gems <enquiries@yourdomain.com>
EMAIL_FROM=
# Where new enquiries are delivered
ADMIN_NOTIFICATION_EMAIL=
